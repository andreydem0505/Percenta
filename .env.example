# Основной адрес сайта. При переезде замените домен и пересоберите приложение.
SITE_URL=https://percenta.ru

# Google Analytics через Firebase: публичные параметры веб-приложения из Firebase Console.
# До включения отключите Enhanced measurement в GA → Администратор → Потоки данных.
# Работает только в production-сборке на HTTPS; на сайте показывается уведомление о cookie.
VITE_ANALYTICS_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
